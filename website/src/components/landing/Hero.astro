---
import { REPO_URL } from '../../lib/site'
import { versions } from '../../lib/versions'
import HeroTv from './HeroTv.astro'

const targets = ['ANDROID', 'IOS', 'MACOS', 'JVM', 'BROWSER']
---

<section class="hero" aria-labelledby="hero-title">
  <div class="copy">
    <h1 id="hero-title" class="disp rgb title">filmstrip</h1>
    <p class="pitch">
      A Kotlin Multiplatform library for editing, encoding and previewing video. Build a composition, preview it in the
      player, then export it to a file.
    </p>
    <ul class="osd targets" aria-label="Targets">
      {targets.map((target) => <li>{target}</li>)}
    </ul>
    <div class="install">
      <code
        >implementation(<wbr /><span class="coordinate"
          >"{versions.group}:<wbr />filmstrip:<wbr />{versions.library}"</span
        >)</code
      >
    </div>
    <div class="actions">
      <a class="cta osd primary" href="/start/quick-start/">QUICK START</a>
      <a class="cta osd source" href={REPO_URL}>VIEW SOURCE</a>
      <a class="cta osd try" href="#try">TRY IT <span aria-hidden="true">&nbsp;▾</span></a>
    </div>
  </div>
  <HeroTv />
</section>

<style>
  .hero {
    max-width: var(--page-width);
    min-height: calc(100vh - var(--header-height, 0px));
    min-height: calc(100svh - var(--header-height, 0px));
    margin: 0 auto;
    padding: clamp(32px, 6vw, 80px) clamp(16px, 4vw, 48px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    gap: clamp(48px, 7vw, 104px);
    align-items: center;
    align-content: center;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 540px;
    min-width: 0;
  }

  .title {
    margin: 0;
    font-size: clamp(30px, 3.8vw, 54px);
    line-height: 1;
    white-space: nowrap;
  }

  .pitch {
    margin: 0;
    font-size: clamp(17px, 1.6vw, 20px);
    line-height: 1.7;
  }

  .targets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 22px;
  }

  .targets li {
    border: 2px solid var(--line-strong);
    padding: 2px 12px;
  }

  .install {
    background: var(--screen);
    border: 1px solid var(--line);
    padding: 14px;
    overflow-x: auto;
  }

  .install code {
    font-family: var(--font-body);
    font-size: 13px;
  }

  .coordinate {
    color: var(--cyan);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .primary {
    background: var(--amber);
    border-color: var(--amber);
    color: var(--ground);
  }

  .primary:hover {
    color: var(--ground);
  }

  .source,
  .source:hover {
    color: var(--text);
  }

  .try,
  .try:hover {
    color: var(--cyan);
  }
</style>
