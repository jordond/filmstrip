---
// A CRT playing an 18 second loop of a beach clip being imported, trimmed, graded, titled, exported and played.
// The frame at each tick comes from heroFrame. The loop stops for reduced motion and while the TV is off screen.
import { heroFrame } from '../../lib/heroTimeline'
import BeachTv from './BeachTv.astro'
---

<BeachTv
  frame={heroFrame(0)}
  led="rec"
  role="img"
  aria-label="A CRT screen editing a beach clip: it is trimmed, colour graded, given a title overlay, then exported and played back."
  data-hero-tv
/>

<script>
  import { drawFrame, tvParts } from '../../lib/beachTv'
  import { HERO_STILL_TICK, HERO_TICK_MS, HERO_TICKS, heroFrame } from '../../lib/heroTimeline'

  const tv = document.querySelector<HTMLElement>('[data-hero-tv]')
  if (tv) {
    const parts = tvParts(tv)
    const draw = (t: number) => drawFrame(parts, heroFrame(t))

    const reduced = matchMedia('(prefers-reduced-motion: reduce)')
    let t = 0
    let timer: ReturnType<typeof setInterval> | undefined
    let onScreen = true

    const stop = () => {
      clearInterval(timer)
      timer = undefined
    }

    const update = () => {
      if (reduced.matches) {
        stop()
        draw(HERO_STILL_TICK)
        return
      }
      if (!onScreen || document.hidden) {
        stop()
        return
      }
      if (timer !== undefined) return
      draw(t)
      timer = setInterval(() => {
        t = (t + 1) % HERO_TICKS
        draw(t)
      }, HERO_TICK_MS)
    }

    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting
      update()
    }).observe(tv)
    reduced.addEventListener('change', update)
    document.addEventListener('visibilitychange', update)
    update()
  }
</script>
