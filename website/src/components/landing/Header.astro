---
import { DOCS_ENTRY, REPO_URL } from '../../lib/site'
---

<header class="header">
  <div class="osd deck" aria-hidden="true">
    <svg width="18" height="20" viewBox="0 0 18 20"><path d="M2 2 L16 10 L2 18 Z" fill="currentColor"></path></svg>
    <span>PLAY</span>
    <span class="speed">SP</span>
  </div>
  <nav aria-label="Main" class="osd nav">
    <a href={DOCS_ENTRY}>DOCS</a>
    <a href="/api/">API</a>
    <a href={REPO_URL}>GITHUB</a>
  </nav>
</header>
<script is:inline>
  {
    const header = document.currentScript.previousElementSibling
    new ResizeObserver(([entry]) => {
      document.documentElement.style.setProperty('--header-height', `${entry.borderBoxSize[0].blockSize}px`)
    }).observe(header)
  }
</script>

<style>
  .header {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 24px var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .deck {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 28px;
    color: var(--amber);
  }

  .speed {
    color: var(--muted);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    font-size: 26px;
  }

  .nav a {
    text-decoration: none;
  }
</style>
