---
// The landing page's OSD mark in place of Starlight's logo and title, with the version menu beside it.
import VersionMenu from '../VersionMenu.astro'
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute
---

<a href={siteTitleHref} class="osd deck">
  <span class="sr-only" translate="no">{siteTitle}</span>
  <svg width="18" height="20" viewBox="0 0 18 20" aria-hidden="true">
    <path d="M2 2 L16 10 L2 18 Z" fill="currentColor"></path>
  </svg>
  <span aria-hidden="true">PLAY</span>
  <span class="speed" aria-hidden="true">SP</span>
</a>
<VersionMenu />

<style>
  .deck {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 28px;
    line-height: 1;
    color: var(--amber);
    text-decoration: none;
    white-space: nowrap;
    margin-inline-end: 16px;
  }

  .deck:hover {
    color: var(--amber-hover);
  }

  .speed {
    color: var(--muted);
  }
</style>
