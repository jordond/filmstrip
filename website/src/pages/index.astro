---
// The landing page. It sits outside the Starlight layout and links into the docs.
import '../styles/fonts.css'
import '../styles/tokens.css'
import '../styles/crt.css'
import '../styles/landing.css'
import tokensCss from '../styles/tokens.css?raw'
import DevBanner from '../components/DevBanner.astro'
import Footer from '../components/landing/Footer.astro'
import Header from '../components/landing/Header.astro'
import Hero from '../components/landing/Hero.astro'
import Platforms from '../components/landing/Platforms.astro'
import QuickStart from '../components/landing/QuickStart.astro'
import TryIt from '../components/landing/TryIt.astro'
import { FAVICON, isPreviewBuild } from '../lib/site'
import { tokenValue } from '../lib/tokens'

const title = 'filmstrip, video for every Kotlin target'
const description =
  'filmstrip is a Kotlin Multiplatform library for editing, encoding and previewing video on Android, iOS, macOS, the JVM and the browser.'
const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={FAVICON} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content={tokenValue(tokensCss, 'ground')} />
    {isPreviewBuild && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body>
    <DevBanner />
    <div class="crt-page">
      <Header />
      <main>
        <Hero />
        <QuickStart />
        <TryIt />
        <Platforms />
      </main>
      <Footer />
    </div>
  </body>
</html>
