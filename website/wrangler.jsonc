{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "filmstrip-docs",
  "compatibility_date": "2026-11-01",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The worker answers what no asset matches: the root, the latest version's number and paths from before versions.
    "not_found_handling": "404-page",
  },
  "workers_dev": false,
  "preview_urls": true,
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "filmstrip.jordond.dev", "custom_domain": true },
    { "pattern": "demo.filmstrip.jordond.dev", "custom_domain": true },
  ],
}
